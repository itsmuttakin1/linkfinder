{
  "rules": {
    ".read": true,
    ".write": "auth != null",
    "links": {
      "$id": {
        ".write": "auth != null || (!data.exists() && newData.exists()) || (data.exists() && newData.exists() && newData.child('originalUrl').val() === data.child('originalUrl').val())"
      }
    },
    "campaigns": {
      "$campaignId": {
        "entries": {
          "$ticketId": {
            ".write": "!data.exists() && newData.exists()"
          }
        }
      }
    },
    "giveaway_entries": {
      "$ticketId": {
        ".write": "!data.exists() && newData.exists()"
      }
    }
  }
}
