{
  "rules": {
    ".read": true,
    ".write": "auth != null",
    "links": {
      ".read": true,
      "$id": {
        ".write": true
      }
    },
    "campaigns": {
      ".read": true,
      "$campaignId": {
        ".write": "auth != null",
        "entries": {
          ".read": true,
          "$ticketId": {
            ".write": "!data.exists() && newData.exists()"
          }
        }
      }
    },
    "giveaway_entries": {
      ".read": true,
      "$ticketId": {
        ".write": "!data.exists() && newData.exists()"
      }
    }
  }
}
